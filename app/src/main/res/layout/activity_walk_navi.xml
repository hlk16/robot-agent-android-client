<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.WalkNaviActivity">

    <!-- 导航信息显示区域 -->
    <LinearLayout
        android:id="@+id/navigation_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#E3F2FD"
        android:elevation="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 转向图标 -->
        <TextView
            android:id="@+id/iv_turn_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"
            android:text="直行"
            android:textSize="12sp"
            android:textColor="#333333"
            android:background="#E8F4FD"
            android:padding="4dp"
            android:minWidth="32dp"
            android:gravity="center" />

        <!-- 导航文字信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_next_road"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="前方路口右转"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1976D2" />

            <TextView
                android:id="@+id/tv_current_road"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前道路：中关村大街"
                android:textSize="12sp"
                android:textColor="#666666" />

        </LinearLayout>

        <!-- 距离和时间信息 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_distance_to_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="200m"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1976D2" />

            <TextView
                android:id="@+id/tv_total_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="剩余 2.5km 8分钟"
                android:textSize="10sp"
                android:textColor="#666666" />

        </LinearLayout>

    </LinearLayout>

    <!-- 路线设置面板 -->
    <LinearLayout
        android:id="@+id/route_setting_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F5F5F5"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/navigation_info_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="路线规划"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp" />

        <!-- 起点输入 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="起点："
                android:textSize="16sp"
                android:textColor="#666666"
                android:gravity="center_vertical" />

            <EditText
                android:id="@+id/et_start_location"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="请输入起点地址"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:padding="12dp"
                android:background="@drawable/bg_message"
                android:singleLine="true" />

            <Button
                android:id="@+id/btn_use_current_location"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="从当前位置导航"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/rounded_corner"
                android:minWidth="80dp" />

        </LinearLayout>

        <!-- 终点输入 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="终点："
                android:textSize="16sp"
                android:textColor="#666666"
                android:gravity="center_vertical" />

            <EditText
                android:id="@+id/et_dest_location"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="请输入终点地址"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:padding="12dp"
                android:background="@drawable/bg_message"
                android:singleLine="true" />

        </LinearLayout>

        <!-- 按钮组 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_start_navigation"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="开始导航"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_nav_button_primary"
                android:elevation="2dp" />

            <Button
                android:id="@+id/btn_toggle_panel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="收起"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:background="@drawable/bg_nav_button_secondary"
                android:elevation="1dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 腾讯地图导航视图 -->
    <com.tencent.map.navi.walk.WalkNaviView
        android:id="@+id/tnk_walk_navi_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/route_setting_panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>