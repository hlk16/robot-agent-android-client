<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 连接状态和控制区域 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:backgroundTint="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔗 连接设置"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <View
                        android:id="@+id/statusIndicator"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/status_indicator_red"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📡 未连接"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:boxStrokeColor="#667eea"
                        app:hintTextColor="#667eea">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUserId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="用户ID"
                            android:text="user001" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:boxStrokeColor="#667eea"
                        app:hintTextColor="#667eea">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNickname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="昵称"
                            android:text="张三" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- 目标用户设置 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:boxStrokeColor="#667eea"
                    app:hintTextColor="#667eea">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTargetUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="目标用户ID (可选，留空为广播)"
                        android:text="user002" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- 在线用户列表 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/rounded_background"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="👥 在线用户"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGetUsers"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="获取用户"
                            android:textColor="#667eea"
                            android:textSize="12sp"
                            app:strokeColor="#667eea"
                            app:cornerRadius="8dp"
                            app:icon="@android:drawable/ic_menu_myplaces"
                            app:iconTint="#667eea"
                            app:iconSize="16dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOnlineUsers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="暂无在线用户"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:background="@drawable/rounded_background"
                        android:padding="12dp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="🚀 连接服务器"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#667eea"
                    app:cornerRadius="28dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>



        <!-- 消息显示区域 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:backgroundTint="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💬 聊天消息"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:padding="16dp"
                    android:paddingBottom="8dp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:padding="16dp"
                    android:paddingTop="0dp">

                    <TextView
                        android:id="@+id/tvMessages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="等待连接..."
                        android:background="@drawable/rounded_background"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:lineSpacingExtra="4dp" />

                </ScrollView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 视频通话预览区域 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:backgroundTint="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📹 视频通话"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp" />

                <!-- 本地视频预览窗口 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="本地视频"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="4dp" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="#000000"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintDimensionRatio="16:9">

                            <org.webrtc.SurfaceViewRenderer
                                android:id="@+id/surfaceViewLocal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <!-- 无信号提示 -->
                            <LinearLayout
                                android:id="@+id/layoutNoLocalSignal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="#1A1A1A"
                                android:visibility="gone">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@android:drawable/ic_menu_camera"
                                    android:layout_marginBottom="8dp"
                                    app:tint="#666666" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="等待本地摄像头连接..."
                                    android:textColor="#999999"
                                    android:textSize="14sp" />

                            </LinearLayout>

                        </FrameLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

                <!-- 远程视频预览窗口 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="远程视频"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="4dp" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="#000000"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintDimensionRatio="16:9">

                            <org.webrtc.SurfaceViewRenderer
                                android:id="@+id/surfaceViewRemote"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <!-- 无信号提示 -->
                            <LinearLayout
                                android:id="@+id/layoutNoRemoteSignal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="#1A1A1A"
                                android:visibility="gone">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@android:drawable/ic_menu_camera"
                                    android:layout_marginBottom="8dp"
                                    app:tint="#666666" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="等待远程视频连接..."
                                    android:textColor="#999999"
                                    android:textSize="14sp" />

                            </LinearLayout>

                        </FrameLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

                <!-- 房间号输入区域 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="输入房间号"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRoomId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="14sp"
                            android:text="test_room" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJoinRoom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="加入房间"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#4CAF50"
                        app:cornerRadius="8dp"
                        app:icon="@android:drawable/ic_menu_add"
                        app:iconSize="16dp"
                        app:iconTint="@android:color/white" />

                </LinearLayout>

                <!-- 摄像头控制按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="4dp">


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCameraToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:text="开启摄像头"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#2196F3"
                        app:cornerRadius="18dp"
                        app:icon="@android:drawable/ic_menu_camera"
                        app:iconSize="16dp"
                        app:iconTint="@android:color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/callbutton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:text="呼叫"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#607D8B"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_call"
                        app:iconSize="16dp"
                        app:iconTint="@android:color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEndCall"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="挂断"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#F44336"
                        app:cornerRadius="18dp"
                        app:icon="@android:drawable/ic_menu_close_clear_cancel"
                        app:iconSize="16dp"
                        app:iconTint="@android:color/white" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 快捷控制按钮区域 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:backgroundTint="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎮 快捷控制"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp" />

                <!-- 第一行：前进按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnForward"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:text="前进"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#4CAF50"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/up"
                        app:iconSize="24dp"
                        app:iconTint="@android:color/white"
                        app:iconGravity="top"
                        app:iconPadding="4dp" />

                </LinearLayout>

                <!-- 第二行：左转、停止、右转 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLeft"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_marginEnd="12dp"
                        android:text="左转"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#FF9800"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/btn_left_select"
                        app:iconSize="20dp"
                        app:iconTint="@android:color/white"
                        app:iconGravity="top"
                        app:iconPadding="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStop"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:text="停止"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#F44336"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_media_pause"
                        app:iconSize="20dp"
                        app:iconTint="@android:color/white"
                        app:iconGravity="top"
                        app:iconPadding="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRight"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_marginStart="12dp"
                        android:text="右转"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#FF9800"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/btn_right_select"
                        app:iconSize="20dp"
                        app:iconTint="@android:color/white"
                        app:iconGravity="top"
                        app:iconPadding="4dp" />

                </LinearLayout>

                <!-- 第三行：后退按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackward"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:text="后退"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#9C27B0"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/down"
                        app:iconSize="24dp"
                        app:iconTint="@android:color/white"
                        app:iconGravity="top"
                        app:iconPadding="4dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 消息发送区域 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:backgroundTint="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✉️ 发送消息"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        app:boxStrokeColor="#667eea"
                        app:hintTextColor="#667eea">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="输入消息..." />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSend"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:text="发送"
                        android:textColor="@android:color/white"
                        android:enabled="false"
                        app:backgroundTint="#667eea"
                        app:cornerRadius="8dp"
                        app:icon="@android:drawable/ic_menu_send"
                        app:iconTint="@android:color/white" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 功能按钮区域 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:backgroundTint="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔧 功能操作"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPing"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="心跳"
                        android:textColor="#4CAF50"
                        app:strokeColor="#4CAF50"
                        app:cornerRadius="8dp"
                        app:icon="@android:drawable/ic_menu_compass"
                        app:iconTint="#4CAF50" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="清空"
                        android:textColor="#FF5252"
                        app:strokeColor="#FF5252"
                        app:cornerRadius="8dp"
                        app:icon="@android:drawable/ic_menu_delete"
                        app:iconTint="#FF5252" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>