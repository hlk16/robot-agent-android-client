<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.NavActivity">

    <!-- 路线设置面板 -->
    <LinearLayout
        android:id="@+id/route_setting_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_margin="8dp"
        android:background="@drawable/bg_voice_container"
        android:backgroundTint="@color/white"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="路线规划"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp" />

        <!-- 起点输入 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="起点："
                android:textSize="16sp"
                android:textColor="#666666"
                android:gravity="center_vertical" />

            <EditText
                android:id="@+id/et_start_location"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="请输入起点地址"
                android:textSize="14sp"
                android:textColor="@color/text_color"
                android:textColorHint="@color/hint_color"
                android:padding="12dp"
                android:background="@drawable/rounded_corner"
                android:singleLine="true" />

        </LinearLayout>

        <!-- 终点输入 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="终点："
                android:textSize="16sp"
                android:textColor="#666666"
                android:gravity="center_vertical" />

            <EditText
                android:id="@+id/et_dest_location"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="请输入终点地址"
                android:textSize="14sp"
                android:textColor="@color/text_color"
                android:textColorHint="@color/hint_color"
                android:padding="12dp"
                android:background="@drawable/rounded_corner"
                android:singleLine="true" />

        </LinearLayout>

        <!-- 按钮组 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_start_navigation"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="开始导航"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_nav_button_primary"
                android:elevation="2dp" />

            <Button
                android:id="@+id/btn_toggle_panel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="收起"
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                android:background="@drawable/bg_nav_button_secondary"
                android:elevation="1dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 腾讯地图导航视图 -->
    <com.tencent.map.navi.walk.WalkNaviView
        android:id="@+id/tnk_walk_navi_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/route_setting_panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>