<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".activities.NBIOTActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 服务器配置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_corner"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MQTT服务器配置"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etServerAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="服务器地址"
                android:text="ssl://d4a0113a.ala.dedicated.aliyun.emqxcloud.cn:8883"
                android:inputType="textUri"
                android:padding="10dp"
                android:background="@drawable/bg_edit_text"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="用户名"
                    android:text="xiaozhi"
                    android:padding="10dp"
                    android:background="@drawable/bg_edit_text"
                    android:layout_marginEnd="4dp"/>

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="密码"
                    android:text="HLKhlk97"
                    android:inputType="textPassword"
                    android:padding="10dp"
                    android:background="@drawable/bg_edit_text"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="连接服务器"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- 连接状态 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未连接"
            android:textSize="14sp"
            android:textColor="#FF0000"
            android:layout_marginBottom="8dp"/>

        <!-- 设备控制区 -->
        <GridLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:verticalSpacing="24dp"
            android:horizontalSpacing="16dp">

            <!-- 灯光控制 -->
            <LinearLayout
                android:layout_columnWeight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_corner">

                <ImageButton
                    android:id="@+id/lightButton"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:src="@drawable/light"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="灯光开关"/>

                <TextView
                    android:id="@+id/lightLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="灯光控制"
                    android:textSize="16sp"
                    android:paddingTop="8dp"/>

                <Switch
                    android:id="@+id/switch1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- 空调控制 -->
            <LinearLayout
                android:layout_columnWeight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_corner">

                <ImageButton
                    android:id="@+id/acButton"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:src="@drawable/aircontril"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="空调开关"/>

                <TextView
                    android:id="@+id/acLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="空调控制"
                    android:textSize="16sp"
                    android:paddingTop="8dp"/>

                <Switch
                    android:id="@+id/switch2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- 门锁控制 -->
            <LinearLayout
                android:layout_columnWeight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_corner">

                <ImageButton
                    android:id="@+id/doorButton"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:src="@drawable/monitor"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="门锁开关"/>

                <TextView
                    android:id="@+id/doorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="监控"
                    android:textSize="16sp"/>

                <Switch
                    android:id="@+id/switch3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- 热水器控制 -->
            <LinearLayout
                android:layout_columnWeight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_corner">

                <ImageButton
                    android:id="@+id/curtainButton"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:src="@drawable/hotwater"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="热水器开关"/>

                <TextView
                    android:id="@+id/curtainLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="热水器"
                    android:textSize="16sp"/>

                <Switch
                    android:id="@+id/switch4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_columnWeight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/test"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="我是测试数据"
                    android:textSize="25dp"/>
            </LinearLayout>

        </GridLayout>

    </LinearLayout>
</ScrollView>
