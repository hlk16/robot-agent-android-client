<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ================================================================
         系统栏图标颜色开关（日间）
         ================================================================
         这类"是不是浅色"的布尔属性无法用颜色资源表达，
         又不能只靠 DayNight 父主题自动推断，因此抽成 @bool 资源，
         夜间版本在 values-night/bools.xml 中覆盖。
         ================================================================ -->

    <!-- 状态栏图标是否用深色（true = 深色图标，配浅色底） -->
    <bool name="window_light_status_bar">true</bool>

    <!-- 导航栏图标是否用深色 -->
    <bool name="window_light_nav_bar">true</bool>
</resources>
