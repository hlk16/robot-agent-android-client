    <!-- ================================================================
         ⬇⬇⬇  以下为语义色，夜间模式在 values-night/colors.xml 中覆盖  ⬇⬇⬇
         布局与 drawable 一律引用这些名字，不要直接写死色值。
         ================================================================ -->

    <!-- 文字 -->
    <color name="text_primary">#FF1A1A1A</color>      <!-- 标题、正文 -->
    <color name="text_secondary">#FF666666</color>    <!-- 次要说明 -->
    <color name="text_tertiary">#FF999999</color>     <!-- 提示、占位 -->
    <color name="text_hint">#FFB7B7B7</color>         <!-- 输入框 hint -->
    <color name="text_on_brand">#FFFFFFFF</color>     <!-- 品牌色底上的文字 -->

    <!-- 表面（背景） -->
    <color name="surface">#FFFFFFFF</color>           <!-- 页面、卡片主背景 -->
    <color name="surface_alt">#FFF5F5F5</color>       <!-- 次级背景、输入框 -->
    <color name="surface_sunken">#FFF6F6F6</color>    <!-- 更深一层的背景 -->
    <color name="surface_translucent">#1A000000</color><!-- 悬浮层半透明背景 -->

    <!-- 边框与分隔 -->
    <color name="divider">#FFE0E0E0</color>
    <color name="divider_strong">#FFCCCCCC</color>
    <color name="line_gray">#FFC7C7C7</color>

    <!-- 兼容旧名称（保持向后引用不报错，值指向语义色） -->
    <color name="text_color">#FF1A1A1A</color>
    <color name="text_color_gray">#FFB4B4B4</color>
    <color name="text_state">#FF797979</color>
    <color name="text_gray">#FF666666</color>
    <color name="text_gray_light">#FFD0D0D0</color>
    <color name="hint_color">#FFB7B7B7</color>
    <color name="border_color">#FFCCCCCC</color>
    <color name="line_color">#FFE5E5E5</color>
    <color name="background_color">#FFF6F6F6</color>
    <color name="background_light_gray">#FFEEEEEE</color>
    <color name="background_gray">#FFAAAAAA</color>
    <color name="back_gray_light">#FFBEBEBE</color>
</resources>
