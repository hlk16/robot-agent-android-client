<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ================================================================
         夜间模式配色
         ===============================================================
         只覆盖「中性色」（文字 / 表面 / 边框）。
         品牌色（brand_primary、success、info、warning 等）不在此覆盖，
         它们会自动沿用 values/colors.xml 中的定义 —— 品牌色在深浅
         底色上都有足够对比度，无需区分。
         ================================================================ -->

    <!-- 文字：深底用浅字 -->
    <color name="text_primary">#FFECECEC</color>
    <color name="text_secondary">#FFADADAD</color>
    <color name="text_tertiary">#FF878787</color>
    <color name="text_hint">#FF6E6E6E</color>
    <color name="text_on_brand">#FFFFFFFF</color>

    <!-- 表面：避免纯黑，用 #121212 保留一点层次感。
         三档亮度拉开，保证「页面底 / 卡片与输入框 / 更深一层」能看出区别 -->
    <color name="surface">#FF121212</color>
    <color name="surface_alt">#FF242424</color>
    <color name="surface_sunken">#FF0D0D0D</color>
    <!-- 半透明容器：夜间要用「提亮」而非「压暗」，
         否则叠在 #121212 上几乎看不出来（原 #33000000 约等于隐形） -->
    <color name="surface_translucent">#26FFFFFF</color>

    <!-- 边框与分隔：深底上要用浅灰，不能是深灰 -->
    <color name="divider">#FF3A3A3A</color>
    <color name="divider_strong">#FF4A4A4A</color>
    <color name="line_gray">#FF3F3F3F</color>

    <!-- 兼容旧名称 -->
    <color name="text_color">#FFECECEC</color>
    <color name="text_color_gray">#FF8A8A8A</color>
    <color name="text_state">#FF9A9A9A</color>
    <color name="text_gray">#FFADADAD</color>
    <color name="text_gray_light">#FF555555</color>
    <color name="hint_color">#FF6E6E6E</color>
    <color name="border_color">#FF3A3A3A</color>
    <color name="line_color">#FF2C2C2C</color>
    <color name="background_color">#FF0D0D0D</color>
    <color name="background_light_gray">#FF1E1E1E</color>
    <color name="background_gray">#FF4A4A4A</color>
    <color name="back_gray_light">#FF4A4A4A</color>

    <!-- ⚠️ 注意：不要覆盖 white / black
         activity_voice.xml 与 activity_voice_call.xml 本身就是刻意设计的深色 UI
         （黑底白字，配合视频背景），覆盖这两个色会把它们意外反转。
         这两个色在布局中的用法需按上下文替换为语义色（surface / text_primary），
         而不是在色板层面做全局反转。 -->
</resources>
