<?xml version="1.0" encoding="utf-8"?>
<!-- 三横线菜单图标。

     三条线等长、等距、两端圆头，居中在 24×24 画布内。
     用语义色 @color/text_primary 而不是写死黑色：
     原图标硬编码了 android:tint="#000000"，深色模式下就是黑底黑线，几乎不可见。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 每条：14×2 的圆角横线，圆角半径 1，实际跨度 x=3..21 -->
    <path
        android:fillColor="@color/text_primary"
        android:pathData="M4,5 h16 a1,1 0 0 1 0,2 h-16 a1,1 0 0 1 0,-2 z" />
    <path
        android:fillColor="@color/text_primary"
        android:pathData="M4,11 h16 a1,1 0 0 1 0,2 h-16 a1,1 0 0 1 0,-2 z" />
    <path
        android:fillColor="@color/text_primary"
        android:pathData="M4,17 h16 a1,1 0 0 1 0,2 h-16 a1,1 0 0 1 0,-2 z" />
</vector>
